---
layout: default
---
<div class="post personal-home">
  <section class="atelier-cover" aria-labelledby="cover-name">
    <canvas class="cover-landscape" aria-hidden="true"></canvas>
    <p class="cover-kicker">YUTANG LIN · 林语瑭 <span>BEIJING, CHINA</span></p>
    <div class="cover-main">
      <p class="cover-intro">Hi, I'm</p>
      <h1 id="cover-name">Yutang</h1>
      <p class="cover-description">I'm a senior at Peking University working on robotics.<br>Outside the lab, you'll probably find me playing tennis or snowboarding.</p>
      <div class="cover-links"><a href="#selected-research">Research ↗</a><a href="{{ '/assets/pdf/Yutang_Lin_CV.pdf' | relative_url }}" target="_blank" rel="noopener">My CV ↗</a><a href="mailto:yutang.lin@stu.pku.edu.cn">Say hello ↗</a></div>
    </div>
    <div class="cover-footer"><span>ROBOTICS / VISION / REINFORCEMENT LEARNING</span><a href="#about-me">Scroll to get to know me ↓</a></div>
  </section>
  <!-- Custom hero -->
  <section class="hero" id="about-me">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-dot" aria-hidden="true"></span>
        <span class="hero-eyebrow-text">{{ page.subtitle | strip_html | strip }}</span>
      </div>

      <h2 class="hero-title">
        {% if site.title == 'blank' %}
          {{ site.first_name }} {{ site.middle_name }}<span class="hero-accent">{{ site.last_name }}</span>
        {% else %}
          {{ site.title }}
        {% endif %}
      </h2>

      <div class="hero-subtitle">{{ content }}</div>

      <ul class="hero-tags">
        <li>🤖 Robotics</li>
        <li>👁️ Computer Vision</li>
        <li>🎮 Reinforcement Learning</li>
      </ul>

      <div class="hero-actions">
        <a class="hero-btn primary no-underline-anim" href="{{ '/publications/' | relative_url }}">
          View publications <i class="ti ti-arrow-right"></i>
        </a>
        <a class="hero-btn ghost no-underline-anim" href="{{ '/assets/pdf/Yutang_Lin_CV.pdf' | relative_url }}" target="_blank" rel="noopener">
          My CV
        </a>
      </div>
    </div>

    {% if page.profile %}
      <div class="hero-portrait">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
          <div class="portrait-frame">
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          </div>
        {% endif %}
        {% if page.profile.more_info %}
          <div class="portrait-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
  </section>

  <!-- Live research stats (Semantic Scholar) -->
  {% assign ss_id = site.data.socials.semanticscholar_id | split: '/' | last %}
  {% if ss_id %}
    <section
      class="research-stats reveal-on-scroll"
      id="research-statistics"
      data-semantic-scholar-id="{{ ss_id }}"
      aria-label="Research statistics"
    >
      <a
        class="stat"
        href="https://www.semanticscholar.org/author/{{ site.data.socials.semanticscholar_id }}"
        target="_blank"
        rel="noopener"
      >
        <span class="stat-value" data-stat="citationCount" data-count="0">—</span>
        <span class="stat-label">Citations</span>
      </a>
      <a
        class="stat"
        href="https://www.semanticscholar.org/author/{{ site.data.socials.semanticscholar_id }}"
        target="_blank"
        rel="noopener"
      >
        <span class="stat-value" data-stat="hIndex" data-count="0">—</span>
        <span class="stat-label">h-index</span>
      </a>
      <a
        class="stat"
        href="{{ '/publications/' | relative_url }}"
      >
        <span class="stat-value" data-stat="paperCount" data-count="0">—</span>
        <span class="stat-label">Publications</span>
      </a>
      <span class="stat-source">
        <i class="ai ai-semantic-scholar"></i> live via Semantic Scholar
      </span>
    </section>
  {% endif %}

  {% include research_experience.liquid %}

  <article>
    <!-- Milestone timeline -->
    {% if site.news != blank %}
      <h2 class="home-section-title">
        <a href="{{ '/news/' | relative_url }}">timeline</a>
      </h2>
      <ol class="timeline">
        {% assign timeline_news = site.news | sort: 'date' | reverse %}
        {% for item in timeline_news limit: 7 %}
          <li class="timeline-item reveal-on-scroll">
            <span class="timeline-marker" aria-hidden="true"></span>
            <time class="timeline-date">{{ item.date | date: '%b %Y' }}</time>
            <div class="timeline-body">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2 class="home-section-title">
        <a href="{{ '/blog/' | relative_url }}">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="home-section-title" id="selected-research">
        <a href="{{ '/publications/' | relative_url }}">publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <section class="off-duty" aria-labelledby="off-duty-title">
      <p class="section-eyebrow">BEYOND THE LAB</p>
      <h2 id="off-duty-title">When I'm <em>not working.</em></h2>
      <p class="off-duty-intro">Two things I enjoy away from my desk.</p>
      <div class="life-grid">
        <div class="life-note"><span class="life-number">01 / ON COURT</span><div class="court-art" aria-hidden="true"><i></i></div><h3>Tennis</h3><p>I enjoy playing tennis and getting a little competitive on court.</p></div>
        <div class="life-note"><span class="life-number">02 / ON THE MOUNTAIN</span><div class="mountain-art" aria-hidden="true"><i></i></div><h3>Snowboarding</h3><p>One of my favorite ways to spend time outside.</p></div>
      </div>
    </section>
    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
