{% assign ufb = site.data.repositories.github_user_fallbacks[include.username] %}

<a
  class="repo-user-card has-spotlight"
  href="https://github.com/{{ include.username }}"
  data-user="{{ include.username }}"
  rel="noopener"
>
  <img
    class="repo-user-avatar"
    src="https://github.com/{{ include.username }}.png?size=160"
    alt="{{ include.username }}"
    loading="lazy"
    width="72"
    height="72"
  >
  <div class="repo-user-body">
    <span class="repo-user-name" data-user-name>{{ ufb.name | default: include.username }}</span>
    <span class="repo-user-login">@{{ include.username }}</span>
    <div class="repo-user-stats">
      <span><strong data-user-repos>{{ ufb.public_repos | default: "–" }}</strong> repos</span>
      <span><strong data-user-followers>{{ ufb.followers | default: "–" }}</strong> followers</span>
      <span><strong data-user-following>{{ ufb.following | default: "–" }}</strong> following</span>
    </div>
  </div>
  <i class="ti ti-brand-github repo-user-ghicon" aria-hidden="true"></i>
</a>
