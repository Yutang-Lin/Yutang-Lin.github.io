{% assign repo_url = include.repository | split: '/' %}
{% assign owner = repo_url[0] %}
{% assign name = repo_url[1] %}
{% if site.data.repositories.github_users contains owner %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

{% assign fb = site.data.repositories.repo_fallbacks[include.repository] %}

<a
  class="repo-card has-spotlight"
  href="https://github.com/{{ include.repository }}"
  data-repo="{{ include.repository }}"
  rel="noopener"
>
  <div class="repo-card-head">
    <i class="ti ti-brand-github repo-card-icon" aria-hidden="true"></i>
    <span class="repo-card-name">
      {% if show_owner %}<span class="repo-card-owner">{{ owner }}/</span>{% endif %}{{ name }}
    </span>
  </div>

  <p class="repo-card-desc" data-repo-desc>
    {{- fb.description | default: "" -}}
  </p>

  <div class="repo-card-meta">
    {% if fb.language %}
      <span class="repo-card-lang" data-repo-lang>
        <span class="repo-card-lang-dot" data-repo-lang-dot></span>{{ fb.language }}
      </span>
    {% else %}
      <span class="repo-card-lang" data-repo-lang hidden>
        <span class="repo-card-lang-dot" data-repo-lang-dot></span><span data-repo-lang-name></span>
      </span>
    {% endif %}
    <span class="repo-card-stat" title="Stars">
      <i class="ti ti-star" aria-hidden="true"></i>
      <span data-repo-stars>{{ fb.stars | default: "–" }}</span>
    </span>
    <span class="repo-card-stat" title="Forks">
      <i class="ti ti-git-fork" aria-hidden="true"></i>
      <span data-repo-forks>{{ fb.forks | default: "–" }}</span>
    </span>
  </div>
</a>
